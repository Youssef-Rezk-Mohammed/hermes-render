#!/usr/bin/env bash
# Boot-time setup for GATEWAY-ONLY Hermes on Back4app Containers (free tier).
# Runs in the s6 cont-init stage, before any service starts.
set -euo pipefail

PORT="${PORT:-8080}"

# 1. Restore persistent state from R2 (best-effort; skipped when R2 vars unset).
/usr/local/bin/sync.sh down || true

mkdir -p /opt/data

# 2. Secrets go in /opt/data/.env (Hermes convention) — never in config.yaml.
if [ -n "${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}" ]; then
  touch /opt/data/.env
  grep -v -e '^GEMINI_API_KEY=' -e '^GOOGLE_API_KEY=' -e '^OPENCODE_ZEN_API_KEY=' /opt/data/.env > /opt/data/.env.tmp || true
  printf 'GEMINI_API_KEY=%s\n' "${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}" >> /opt/data/.env.tmp
  chmod 600 /opt/data/.env.tmp
  mv /opt/data/.env.tmp /opt/data/.env
fi

# 3. Minimal config using the BUILT-IN gemini provider plugin — no custom
# provider plumbing, no dashboard auth. The web dashboard stays disabled.
cat > /opt/data/config.yaml <<EOF
_config_version: 12
model:
  provider: gemini
  default: ${GEMINI_MODEL:-gemini-3.6-flash}
EOF

# 4. Static health endpoint on $PORT (Back4app probes http://host:$PORT/).
# Serves a fixed tiny directory — NEVER /opt/data (no secret file exposure).
mkdir -p /srv/health
printf 'hermes gateway running\n' > /srv/health/index.html
setsid bash -c 'cd /srv/health && while true; do python3 -m http.server '"$PORT"' --bind 0.0.0.0 >/var/log/health-stub.log 2>&1 || true; sleep 1; done' >/dev/null 2>&1 &

# 5. Push state to R2 every 5 minutes (detached).
setsid bash -c 'while true; do sleep 300; /usr/local/bin/sync.sh up || true; done' >/var/log/sync.log 2>&1 &

# 6. Self-healing Telegram watchdog.
# Problem: Back4app redeploys overlap old+new containers; during that window both
# poll Telegram. get-updates probing is forbidden because it steals the long-poll
# slot — the newcomer is always served 200 while the pending request gets 409, and
# the gateway's 5-retry conflict budget gets burned until it goes deaf.
# Safe signal: pending_update_count growth via getWebhookInfo (a read-only endpoint).
# Updates accumulate only when nobody fetches them. Remedy: kill the gateway
# process; s6 supervision auto-restarts it and it claims the free slot.
if [ -n "${TELEGRAM_BOT_TOKEN:-}" ]; then
  setsid bash -c '
    sleep 420                      # allow normal first-boot connection attempt
    streak=0
    while true; do
      resp=$(curl -s --max-time 15 "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getWebhookInfo" \
             | tr -d " \n") || resp=""
      
      if [ -z "$resp" ]; then
        streak=0
        sleep 300
        continue
      fi

      hook=$(printf "%s" "$resp" | grep -c "\"url\":\"\"") || hook=0
      if [ "$hook" = "0" ]; then  # webhook mode configured; never interfere
        sleep 300; continue
      fi

      pending=$(printf "%s" "$resp" | sed -n '\''s/.*"pending_update_count":\([0-9][0-9]*\).*/\1/p'\'')
      if [ -z "$pending" ]; then
        streak=0
        sleep 300
        continue
      fi

      if [ "$pending" -gt 0 ]; then
        streak=$((streak + 1))
      else
        streak=0
      fi

      if [ "$streak" -ge 3 ]; then
        echo "$(date -u +%FT%TZ) unconsumed updates detected (count: $pending); restarting gateway" >> /var/log/tg-watchdog.log
        pkill -f "gateway run" || pkill -f "hermes_cli.main" || true
        streak=0
        sleep 120                   # give the fresh gateway time to claim the slot
        continue
      fi
      
      sleep 300
    done' >/dev/null 2>&1 &
fi

exit 0
