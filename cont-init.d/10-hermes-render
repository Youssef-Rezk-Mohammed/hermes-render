#!/usr/bin/env bash
# Runs at container boot (s6 cont-init stage), before the gateway/dashboard services start.
set -euo pipefail

# 1. Restore persistent state from R2 (best-effort).
/usr/local/bin/sync.sh down || true

# 2. Replace any image- or R2-provided config with the OpenCode Zen custom provider.
# This prevents an old schema from blocking startup and ensures this service always
# uses the provider configured in Render.
mkdir -p /opt/data
yaml_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

dashboard_password="${DASHBOARD_PASSWORD:?DASHBOARD_PASSWORD must be set}"
dashboard_username="${DASHBOARD_USER:-admin}"
dashboard_secret="$(printf '%s' "hermes-render-dashboard-v1:${dashboard_password}" | sha256sum | awk '{print $1}')"
dashboard_password_hash="$(printf '%s' "$dashboard_password" | python -c 'import sys; from plugins.dashboard_auth.basic import hash_password; print(hash_password(sys.stdin.read()))')"

cat > /opt/data/config.yaml <<EOF
_config_version: 12
model:
  provider: custom
  default: $(yaml_quote "${OPENCODE_MODEL:-deepseek-v4-flash}")
  base_url: $(yaml_quote "${OPENCODE_BASE_URL:-https://opencode.ai/zen/v1}")
  api_key: $(yaml_quote "${OPENCODE_API_KEY:-}")
dashboard:
  basic_auth:
    username: $(yaml_quote "$dashboard_username")
    password_hash: $(yaml_quote "$dashboard_password_hash")
    secret: $(yaml_quote "$dashboard_secret")
EOF

# 3. The upstream dashboard service starts after cont-init and uses
# /command/with-contenv. Set its runtime configuration in s6's container envdir;
# shell exports from this script would not be inherited by that service.
set_container_env() {
  local name="$1"
  local value="$2"
  local envdir="/run/s6/container_environment"
  local temporary

  temporary="$(mktemp "${envdir}/.${name}.XXXXXX")"
  printf '%s' "$value" > "$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "${envdir}/${name}"
}

set_container_env HERMES_DASHBOARD "1"
set_container_env HERMES_DASHBOARD_HOST "0.0.0.0"
set_container_env HERMES_DASHBOARD_PORT "${PORT:-10000}"

# 4. Start the R2 sync loop (every 5 min) detached.
setsid bash -c 'while true; do sleep 300; /usr/local/bin/sync.sh up || true; done' >/var/log/sync.log 2>&1 &

exit 0
